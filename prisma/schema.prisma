generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id           Int        @id @default(autoincrement())
  name         String
  username     String     @unique
  email        String?
  passwordHash String     @map("password_hash")
  role         String
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  created      Purchase[] @relation("creator")
  updated      Purchase[] @relation("updater")
  @@map("users")
}
model Location {
  id          Int        @id @default(autoincrement())
  code        String     @unique
  name        String
  description String     @default("")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  purchases   Purchase[]
  @@map("locations")
}
model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  products    Product[]
  @@map("categories")
}
model Unit {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  symbol   String?
  isActive Boolean   @default(true) @map("is_active")
  products Product[]
  @@map("units")
}
model Product {
  id           Int            @id @default(autoincrement())
  code         String         @default("")
  categoryId   Int            @map("category_id")
  unitId       Int            @map("unit_id")
  name         String
  defaultPrice Decimal        @default(0) @map("default_price") @db.Decimal(14, 2)
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  category     Category       @relation(fields: [categoryId], references: [id])
  unit         Unit           @relation(fields: [unitId], references: [id])
  items        PurchaseItem[]
  @@map("products")
}
model Purchase {
  id                Int            @id @default(autoincrement())
  transactionNumber String         @unique @map("transaction_number")
  date              DateTime       @map("transaction_date") @db.Date
  locationId        Int            @map("location_id")
  description       String         @default("")
  createdBy         Int            @map("created_by")
  updatedBy         Int?           @map("updated_by")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  location          Location       @relation(fields: [locationId], references: [id])
  creator           User           @relation("creator", fields: [createdBy], references: [id])
  updater           User?          @relation("updater", fields: [updatedBy], references: [id])
  items             PurchaseItem[]
  @@index([date])
  @@index([locationId])
  @@map("purchases")
}
model PurchaseItem {
  id           Int      @id @default(autoincrement())
  purchaseId   Int      @map("purchase_id")
  productId    Int?     @map("product_id")
  productName  String   @map("product_name")
  categoryName String   @map("category_name")
  unitName     String   @map("unit_name")
  qty          Decimal  @db.Decimal(12, 2)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(14, 2)
  totalPrice   Decimal  @map("total_price") @db.Decimal(16, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id])
  @@index([purchaseId])
  @@map("purchase_items")
}
